msgctxt "Addon Summary"
msgid "Automatically forces software decoding for rotated or otherwise broken video played from chosen paths, restoring hardware decoding afterwards."
msgstr ""

msgctxt "Addon Description"
msgid "CoreELEC's amcodec hardware decoder mishandles some videos: rotated phone/camera clips usually play stretched (occasionally with the wrong orientation), and some old MJPEG AVI clips won't play at all. Limp detects affected files and forces software decoding just for those, restoring hardware decoding afterwards. Scope it to specific paths, or apply everywhere."
msgstr ""

msgctxt "#32000"
msgid "Paths"
msgstr ""

msgctxt "#32014"
msgid "Apply everywhere (not recommended)"
msgstr ""

msgctxt "#32015"
msgid "Applies to every video played, not just under the paths below. Not recommended - without a path to exclude modern high-resolution video, this can force unnecessary, CPU-heavy software decoding on files that don't need it."
msgstr ""

msgctxt "#32012"
msgid "Or, limit by these paths..."
msgstr ""

